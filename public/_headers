# Cache- und Sicherheits-Header für Cloudflare Pages (gilt nur für statische Dateien, nicht für Functions)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Schriften ändern sich nie: ein Jahr im Browser-Cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Bilder: eine Woche, danach im Hintergrund auffrischen
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# CSS/JS ohne Versions-Hash: kurz cachen, damit Änderungen schnell ankommen
/css/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
/js/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/schattenschreck-2027.ics
  Content-Type: text/calendar; charset=utf-8

/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
